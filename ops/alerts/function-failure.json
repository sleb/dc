{
  "displayName": "dc function failure",
  "combiner": "OR",
  "userLabels": {
    "managed_by": "ops-apply"
  },
  "notificationChannels": [
    "__NOTIFICATION_CHANNEL__"
  ],
  "documentation": {
    "mimeType": "text/markdown",
    "content": "A function has written `api.error` lines for 10 minutes (LLD 0 section 9, the function-failure row). `logError` writes that line for an unexpected throw only, so each one is also an Error Reporting group; open the group for the stack."
  },
  "conditions": [
    {
      "displayName": "dc function failure",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/dc_api_error_total\" resource.type=\"cloud_run_revision\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "600s",
        "trigger": {
          "count": 1
        },
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ]
      }
    }
  ]
}
