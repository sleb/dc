{
  "displayName": "dc stuck deletion",
  "combiner": "OR",
  "userLabels": {
    "managed_by": "ops-apply"
  },
  "notificationChannels": [
    "__NOTIFICATION_CHANNEL__"
  ],
  "documentation": {
    "mimeType": "text/markdown",
    "content": "A game deletion has been stuck (LLD 0 section 9, LLD 3). The line names the game id; re-run the deletion runner once the cause is fixed."
  },
  "conditions": [
    {
      "displayName": "dc stuck deletion",
      "conditionMatchedLog": {
        "filter": "jsonPayload.event=\"deletion.stuck\"",
        "labelExtractors": {
          "gameId": "EXTRACT(jsonPayload.gameId)"
        }
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    }
  }
}
