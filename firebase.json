{
  "functions": [
    {
      "source": "functions/dist",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "*.log", ".install-ok", ".env.local", ".env.*.local"],
      "predeploy": ["bun run build:functions"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
