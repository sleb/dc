{
  "name": "deepcuts",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p lint-test/tsconfig.json",
    "test:lint": "bun test lint-test",
    "build:functions": "bun run --cwd functions build"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
